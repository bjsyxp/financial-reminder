/* 理财提醒 - 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  background: #f1f5f9;
  color: #1e293b;
  font-size: 14px;
  line-height: 1.5;
}

/* 颜色变量还原PWA原有配色 */
.primary { color: #2563eb; }
.success { color: #059669; }
.warning { color: #d97706; }
.danger { color: #dc2626; }
.primary-bg { background: #2563eb; }
.text-muted { color: #64748b; font-size: 12px; }

/* 到期标签颜色 — 按年分级 */
.tag-expired { background: #fee2e2; color: #dc2626; }
.tag-y1      { background: #fef3c7; color: #d97706; }
.tag-y2      { background: #dbeafe; color: #2563eb; }
.tag-y3      { background: #d1fae5; color: #059669; }
.tag-y4      { background: #ede9fe; color: #8b5cf6; }
