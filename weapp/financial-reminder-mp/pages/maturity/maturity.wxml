  </view>

  <!-- 活期 -->
  <view class="section">
    <view class="section-header">
      <view class="section-dot current"></view>
      <text class="section-title">活期 ({{groups.current.length}})</text>
    </view>
    <view class="section-body" wx:if="{{groups.current.length > 0}}">
      <view class="m-item" wx:for="{{groups.current}}" wx:key="id" bindtap="editRecord" data-id="{{item.id}}">
        <view class="m-top"><text class="m-inst">{{item.inst}}</text><text class="m-amount">{{util.fmtMoney(item.amount)}}</text></view>
        <view class="m-mid"><text class="m-type">{{util.TYPE_LABELS[item.type]}}</text><text class="m-rate">{{item.rate}}%</text></view>
        <view class="m-bot"><text class="tag tag-ok">无到期</text><text class="m-end">长期持有</text></view>
      </view>
    </view>
    <view class="empty-section" wx:else><text>—</text></view>
  </view>
</view>
