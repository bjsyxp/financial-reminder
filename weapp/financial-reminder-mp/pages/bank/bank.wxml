<!-- 银行汇总 -->
<view class="page">
  <view class="total-row">
    <view class="total-card">
      <text class="total-label">合计资产</text>
      <text class="total-value">{{totalWan}}</text>
      <text class="total-sub">{{totalMoney}}</text>
    </view>
  </view>

  <view class="bank-list">
    <view class="bank-item" wx:for="{{banks}}" wx:key="inst">
      <view class="bank-header">
        <text class="bank-name">{{item.inst}}</text>
        <text class="bank-total">{{util.fmtMoney(item.total)}}</text>
      </view>
      <view class="bank-stats">
        <text>共 {{item.count}} 笔</text>
        <text wx:if="{{item.deposit > 0}}">定期 {{util.fmtMoney(item.deposit)}}</text>
        <text wx:if="{{item.wealth > 0}}">理财 {{util.fmtMoney(item.wealth)}}</text>
        <text wx:if="{{item.current > 0}}">活期 {{util.fmtMoney(item.current)}}</text>
      </view>
    </view>
  </view>
</view>
