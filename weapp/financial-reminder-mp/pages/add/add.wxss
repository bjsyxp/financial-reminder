/* 添加页 */
.page { padding: 16px; min-height: 100vh; }
.form { max-width: 400px; margin: 0 auto; }
.form-group { margin-bottom: 16px; }
.form-label { font-size: 13px; color: #64748b; margin-bottom: 6px; display: block; }
.form-input {
  width: 100%; height: 44px; background: white; border-radius: 10px;
  border: 1px solid #e2e8f0; padding: 0 12px; font-size: 15px; color: #1e293b;
}
.form-picker { line-height: 44px; color: #1e293b; }
.form-picker[value=''] { color: #94a3b8; }

/* 类型选择 */
.type-select { display: flex; gap: 8px; }
.type-option {
  flex: 1; text-align: center; padding: 10px 4px; border-radius: 10px;
  border: 1px solid #e2e8f0; font-size: 13px; background: white;
}
.type-option.active { border-width: 2px; }
.type-option.type-g.active { border-color: #059669; color: #059669; background: #d1fae5; }
.type-option.type-b.active { border-color: #2563eb; color: #2563eb; background: #dbeafe; }
.type-option.type-p.active { border-color: #8b5cf6; color: #8b5cf6; background: #ede9fe; }

.form-btn {
  width: 100%; height: 46px; line-height: 46px; background: #2563eb; color: white;
  border-radius: 12px; font-size: 16px; font-weight: 600; margin-top: 20px;
}
.form-btn::after { border: none; }
.form-btn-cancel { background: #f1f5f9; color: #64748b; margin-top: 8px; }
