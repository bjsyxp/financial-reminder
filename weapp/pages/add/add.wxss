/* 添加页 — 完全对照源程序 */
.page { padding: 16px; padding-bottom: 30px; min-height: 100vh; background: #f1f5f9; }
.form { max-width: 420px; margin: 0 auto; }

.form-section { margin-bottom: 16px; }
.form-label { font-size: 13px; color: #1e293b; font-weight: 500; margin-bottom: 6px; display: block; }
.form-label-sm { font-size: 11px; color: #64748b; font-weight: 400; }
.form-row { display: flex; gap: 12px; }
.form-half { flex: 1; min-width: 0; }

.form-input {
  width: 100%; height: 44px; background: white; border-radius: 10px;
  border: 1px solid #e2e8f0; padding: 0 12px; font-size: 15px; color: #1e293b;
}
.form-picker { line-height: 44px; color: #94a3b8; }
.form-picker[value] { color: #1e293b; }

/* 常用银行标签 */
.bank-tags {
  display: flex; gap: 6px; overflow-x: auto; white-space: nowrap;
  padding-bottom: 8px; margin-bottom: 6px;
}
.bank-tag {
  display: inline-block; padding: 5px 12px; background: #f1f5f9;
  border: 1px solid #e2e8f0; border-radius: 16px; font-size: 12px; color: #475569;
  flex-shrink: 0;
}
.bank-tag:active { background: #dbeafe; border-color: #2563eb; color: #2563eb; }

/* 类型选择 */
.type-select { display: flex; gap: 8px; }
.type-opt {
  flex: 1; text-align: center; padding: 10px 4px; border-radius: 10px;
  border: 1px solid #e2e8f0; font-size: 13px; background: white;
}
.type-opt.active { border-width: 2px; font-weight: 600; }
.type-opt.active[data-type="deposit"] { border-color: #059669; color: #059669; background: #d1fae5; }
.type-opt.active[data-type="wealth"] { border-color: #2563eb; color: #2563eb; background: #dbeafe; }
.type-opt.active[data-type="current"] { border-color: #8b5cf6; color: #8b5cf6; background: #ede9fe; }

/* 后缀 */
.input-suffix { position: relative; }
.input-suffix .form-input { padding-right: 36px; }
.suffix {
  position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
  font-size: 13px; color: #94a3b8; pointer-events: none;
}

/* 利息预览 */
.preview {
  background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 10px;
  padding: 10px 12px; display: flex; align-items: center; gap: 8px; margin-bottom: 16px;
}
.preview-icon { font-size: 14px; flex-shrink: 0; }
.preview-text { font-size: 13px; color: #0369a1; line-height: 1.5; }

/* 按钮 */
.form-save {
  width: 100%; height: 46px; line-height: 46px; background: #2563eb; color: white;
  border-radius: 12px; font-size: 16px; font-weight: 600; margin-top: 4px;
}
.form-save::after { border: none; }
.form-cancel {
  width: 100%; height: 46px; line-height: 46px; background: #f1f5f9; color: #64748b;
  border-radius: 12px; font-size: 15px; margin-top: 8px;
}
.form-cancel::after { border: none; }
