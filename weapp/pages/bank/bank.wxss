/* 银行汇总 — 可展开明细 */
.page { padding: 12px; min-height: 100vh; background: #f1f5f9; }

/* ─── 合计卡片 ─── */
.total-card {
  background: linear-gradient(135deg, #1e40af, #3b82f6);
  color: white; border-radius: 20px; padding: 28px 24px; text-align: center;
  margin-bottom: 16px; box-shadow: 0 4px 20px rgba(37,99,235,0.25);
}
.tc-label { font-size: 13px; opacity: 0.75; display: block; margin-bottom: 4px; }
.tc-value { font-size: 32px; font-weight: 800; display: block; margin-bottom: 4px; }
.tc-sub { font-size: 13px; opacity: 0.6; }

/* ─── 银行列表 ─── */
.bank-list { display: flex; flex-direction: column; gap: 10px; }
.bank-item {
  background: white; border-radius: 16px; padding: 16px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  transition: all 0.2s;
}
.bank-item:active { transform: scale(0.99); }

/* ─── 顶部 ─── */
.bi-top { display: flex; justify-content: space-between; align-items: center; }
.bi-left { display: flex; flex-direction: column; gap: 2px; }
.bi-name { font-size: 16px; font-weight: 700; }
.bi-count { font-size: 11px; color: #94a3b8; }
.bi-right { display: flex; align-items: center; gap: 8px; }
.bi-total { font-size: 17px; font-weight: 800; color: #2563eb; }
.bi-arrow { font-size: 22px; color: #94a3b8; transition: transform 0.2s; }
.bi-arrow.up { transform: rotate(90deg); }

/* ─── 类型标签（收起时） ─── */
.bi-types { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.bi-type { font-size: 11px; color: #64748b; background: #f8fafc; padding: 3px 10px; border-radius: 6px; }

/* ─── 展开明细 ─── */
.bi-detail { margin-top: 12px; border-top: 1px solid #f1f5f9; padding-top: 10px; display: flex; flex-direction: column; gap: 8px; }
.bd-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8px 12px; background: #f8fafc; border-radius: 10px;
}
.bd-top { display: flex; flex-direction: column; gap: 2px; }
.bd-amount { font-size: 14px; font-weight: 600; }
.bd-type { font-size: 10px; padding: 1px 6px; border-radius: 3px; display: inline-block; width: fit-content; }
.bd-type.type-deposit { background: #d1fae5; color: #059669; }
.bd-type.type-wealth { background: #dbeafe; color: #2563eb; }
.bd-type.type-current { background: #ede9fe; color: #8b5cf6; }
.bd-bot { text-align: right; }
.bd-rate { font-size: 13px; font-weight: 600; display: block; }
.bd-date { font-size: 10px; color: #94a3b8; }
