<!-- 银行汇总 — 可展开 -->
<view class="page">
  <view class="total-card">
    <text class="tc-label">合计资产</text>
    <text class="tc-value">{{totalStr}}</text>
  </view>

  <view class="bank-list">
    <view class="bank-item" wx:for="{{banks}}" wx:key="inst" data-inst="{{item.inst}}" bindtap="toggleBank">
      <view class="bi-top">
        <view class="bi-left">
          <text class="bi-name">{{item.inst}}</text>
          <text class="bi-count">{{item.count}} 笔</text>
        </view>
        <view class="bi-right">
          <text class="bi-total">{{item._totalWan}}</text>
          <text class="bi-arrow {{item.expanded ? 'up' : ''}}">›</text>
        </view>
      </view>
      <view class="bi-types" wx:if="{{!item.expanded}}">
        <text class="bi-type type-tag-g" wx:if="{{item.deposit > 0}}">定期 {{item._depositWan}}</text>
        <text class="bi-type type-tag-b" wx:if="{{item.wealth > 0}}">理财 {{item._wealthWan}}</text>
        <text class="bi-type type-tag-p" wx:if="{{item.current > 0}}">活期 {{item._currentWan}}</text>
      </view>

      <!-- 展开明细 -->
      <view class="bi-detail" wx:if="{{item.expanded}}">
        <view class="bd-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="sub">
          <view class="bd-top">
            <text class="bd-amount">{{sub._amountWan}}</text>
            <text class="bd-type bd-tag-{{sub.type}}">{{sub.type === 'deposit' ? '定期存款' : sub.type === 'wealth' ? '理财产品' : '活期存款'}}</text>
          </view>
          <view class="bd-bot">
            <text class="bd-rate">{{sub.rate}}%</text>
            <text wx:if="{{sub.end}}" class="bd-date">{{sub._dateRange}}</text>
            <text wx:else class="bd-date">{{sub._dateLong}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
