<!-- 首页：资产列表 -->
<view class="page">

  <!-- 密码锁 -->
  <view class="lock-overlay {{locked ? 'show' : ''}}">
    <view class="lock-box">
      <view class="lock-icon">🔒</view>
      <view class="lock-title">理财提醒</view>
      <view class="lock-subtitle">请输入密码</view>
      <view class="lock-input-area">
        <input class="lock-input" type="text" maxlength="20"
          focus="{{lockFocus}}" value="{{pwdInput}}" bindinput="onPwdInput" bindconfirm="onPwdConfirm"
          password="{{!showPwd}}" always-embed="{{true}}" />
        <text class="lock-toggle" bindtap="togglePwdShow">{{showPwd ? '隐藏' : '显示'}}</text>
      </view>
      <view class="lock-error">{{pwdError}}</view>
      <view class="lock-actions">
        <button class="lock-btn" bindtap="onPwdConfirm">解锁</button>
        <button class="lock-btn lock-btn-set" wx:if="{{!hasPassword}}" bindtap="onSetPwd">设置密码</button>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card blue">
      <view class="stat-label">总资产</view>
      <view class="stat-value">{{stats.totalWan}}</view>
      <view class="stat-sub">{{stats.totalMoney}}</view>
    </view>
    <view class="stat-card green">
      <view class="stat-label">总收益</view>
      <view class="stat-value">{{stats.interestWan}}</view>
      <view class="stat-sub">{{stats.interestMoney}}</view>
    </view>
    <view class="stat-card orange">
      <view class="stat-label">笔数</view>
      <view class="stat-value">{{stats.count}}</view>
      <view class="stat-sub">当前持有</view>
    </view>
  </view>

  <!-- 类型速览 -->
  <view class="type-bar">
    <view class="type-item {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">
      <text>全部</text>
      <text class="type-count">{{byType.all.count}}</text>
    </view>
    <view class="type-item {{filter === 'deposit' ? 'active' : ''}}" bindtap="setFilter" data-filter="deposit">
      <text>定期</text>
      <text class="type-count type-count-g">{{byType.deposit.count}}</text>
    </view>
    <view class="type-item {{filter === 'wealth' ? 'active' : ''}}" bindtap="setFilter" data-filter="wealth">
      <text>理财</text>
      <text class="type-count type-count-b">{{byType.wealth.count}}</text>
    </view>
    <view class="type-item {{filter === 'current' ? 'active' : ''}}" bindtap="setFilter" data-filter="current">
      <text>活期</text>
      <text class="type-count type-count-p">{{byType.current.count}}</text>
    </view>
  </view>

  <!-- 列表 -->
  <scroll-view class="list-scroll" scroll-y="{{true}}" bindscrolltolower="loadMore">
    <view class="list">
      <view class="list-item" wx:for="{{filteredRecords}}" wx:key="id" bindtap="editRecord" data-id="{{item.id}}" bindlongpress="deleteRecord" data-id="{{item.id}}">
        <view class="item-top">
          <view class="item-inst">{{item.inst}}</view>
          <view class="item-amount">{{util.fmtWan(item.amount)}}</view>
        </view>
        <view class="item-mid">
          <text class="item-type type-tag type-{{item.type}}">{{util.TYPE_LABELS[item.type]}}</text>
          <text class="item-rate">{{item.rate}}%</text>
          <text class="item-date">{{util.fmtDate(item.start)}} ~ {{item.end ? util.fmtDate(item.end) : '长期'}}</text>
        </view>
        <view class="item-bot">
          <view class="chip {{chipData[item.id].cls}}">{{chipData[item.id].text}}</view>
          <view class="item-profit">日收益 {{util.fmtMoney(profitDaily[item.id])}} | 总收益 {{util.fmtMoney(profitData[item.id])}}</view>
        </view>
      </view>

      <view class="empty" wx:if="{{filteredRecords.length === 0}}">
        <text class="empty-icon">📋</text>
        <text>还没有记录，点击 + 添加</text>
      </view>
    </view>
  </scroll-view>

  <!-- 添加按钮 -->
  <view class="fab" bindtap="addRecord">+</view>
</view>
