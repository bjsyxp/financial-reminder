<!-- 到期提醒 — 仅1/2/3年 -->
<view class="page">
  <!-- 顶部统计 -->
  <view class="hero">
    <view class="hero-title">到期概览</view>
    <view class="hero-row">
      <view class="hero-item">
        <text class="hero-num">{{stats.count}}</text>
        <text class="hero-label">即将到期</text>
      </view>
      <view class="hero-item">
        <text class="hero-num hero-num-o">{{util.fmtWan(stats.y1)}}</text>
        <text class="hero-label">1年内需关注</text>
      </view>
    </view>
  </view>

  <!-- 1年内 -->
  <view class="section" wx:if="{{groups.y1.length > 0}}">
    <view class="sec-head">
      <view class="sec-dot dot-o"></view>
      <text class="sec-title">1年内到期</text>
      <text class="sec-amount">{{util.fmtMoney(stats.y1)}}</text>
    </view>
    <view class="sec-body">
      <view class="m-card" wx:for="{{groups.y1}}" wx:key="id" bindtap="editRecord" data-id="{{item.id}}">
        <view class="mc-top">
          <view class="mc-inst">{{item.inst}}</view>
          <view class="mc-amount">{{util.fmtWan(item.amount)}}</view>
        </view>
        <view class="mc-mid">
          <text class="mc-type type-deposit" wx:if="{{item.type === 'deposit'}}">定期</text>
          <text class="mc-type type-wealth" wx:if="{{item.type === 'wealth'}}">理财</text>
          <text class="mc-rate">{{item.rate}}%</text>
          <text class="mc-date">{{util.fmtDate(item.start)}} ~ {{util.fmtDate(item.end)}}</text>
        </view>
        <view class="mc-bot">
          <text class="chip chip-o">{{chipData[item.id].text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 2年内 -->
  <view class="section" wx:if="{{groups.y2.length > 0}}">
    <view class="sec-head">
      <view class="sec-dot dot-b"></view>
      <text class="sec-title">2年内到期</text>
      <text class="sec-amount">{{util.fmtMoney(stats.y2)}}</text>
    </view>
    <view class="sec-body">
      <view class="m-card" wx:for="{{groups.y2}}" wx:key="id" bindtap="editRecord" data-id="{{item.id}}">
        <view class="mc-top">
          <view class="mc-inst">{{item.inst}}</view>
          <view class="mc-amount">{{util.fmtWan(item.amount)}}</view>
        </view>
        <view class="mc-mid">
          <text class="mc-type type-deposit" wx:if="{{item.type === 'deposit'}}">定期</text>
          <text class="mc-type type-wealth" wx:if="{{item.type === 'wealth'}}">理财</text>
          <text class="mc-rate">{{item.rate}}%</text>
          <text class="mc-date">{{util.fmtDate(item.start)}} ~ {{util.fmtDate(item.end)}}</text>
        </view>
        <view class="mc-bot">
          <text class="chip chip-b">{{chipData[item.id].text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3年内 -->
  <view class="section" wx:if="{{groups.y3.length > 0}}">
    <view class="sec-head">
      <view class="sec-dot dot-g"></view>
      <text class="sec-title">3年内到期</text>
      <text class="sec-amount">{{util.fmtMoney(stats.y3)}}</text>
    </view>
    <view class="sec-body">
      <view class="m-card" wx:for="{{groups.y3}}" wx:key="id" bindtap="editRecord" data-id="{{item.id}}">
        <view class="mc-top">
          <view class="mc-inst">{{item.inst}}</view>
          <view class="mc-amount">{{util.fmtWan(item.amount)}}</view>
        </view>
        <view class="mc-mid">
          <text class="mc-type type-deposit" wx:if="{{item.type === 'deposit'}}">定期</text>
          <text class="mc-type type-wealth" wx:if="{{item.type === 'wealth'}}">理财</text>
          <text class="mc-rate">{{item.rate}}%</text>
          <text class="mc-date">{{util.fmtDate(item.start)}} ~ {{util.fmtDate(item.end)}}</text>
        </view>
        <view class="mc-bot">
          <text class="chip chip-g">{{chipData[item.id].text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 活期 -->
  <view class="section" wx:if="{{groups.current.length > 0}}">
    <view class="sec-head">
      <view class="sec-dot dot-p"></view>
      <text class="sec-title">活期存款</text>
      <text class="sec-amount">{{util.fmtMoney(stats.current)}}</text>
    </view>
    <view class="sec-body">
      <view class="m-card" wx:for="{{groups.current}}" wx:key="id" bindtap="editRecord" data-id="{{item.id}}">
        <view class="mc-top">
          <view class="mc-inst">{{item.inst}}</view>
          <view class="mc-amount">{{util.fmtWan(item.amount)}}</view>
        </view>
        <view class="mc-mid">
          <text class="mc-type type-current">活期</text>
          <text class="mc-rate">{{item.rate}}%</text>
          <text class="mc-date">{{util.fmtDate(item.start)}} ~ 长期</text>
        </view>
        <view class="mc-bot">
          <text class="chip chip-p">无到期</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 全部为空 -->
  <view class="empty-state" wx:if="{{totalCount === 0}}">
    <text class="empty-icon">🎉</text>
    <text class="empty-text">暂无即将到期的资产</text>
  </view>
</view>
